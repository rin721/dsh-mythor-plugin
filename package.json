{
  "name": "dsh-mythor-plugin",
  "version": "0.1.0",
  "description": "Mythor: persistent novel creation, knowledge and story relationships for DeepSeek Harness",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./types": "./lib/types/shared/contracts.d.ts",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "docs"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts package.json tsconfig.json tsconfig.build.json vitest.config.ts vitest.ui.config.ts",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json tsconfig.build.json vitest.config.ts vitest.ui.config.ts",
    "test": "vitest run && pnpm test:ui && pnpm check:ui",
    "pretest": "pnpm build",
    "check:docs": "node scripts/check-docs.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "prepack": "pnpm build",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "check:ui": "node scripts/check-ui.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.8.1",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-select": "2.2.6",
    "clsx": "2.1.1",
    "cytoscape": "3.33.1",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-code-language": "0.1.7-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@shikijs/langs": "4.3.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "anser": "2.3.5",
    "diff": "9.0.0",
    "esbuild": "^0.25.0",
    "immer": "10.1.1",
    "jsdom": "26.1.0",
    "katex": "0.16.47",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "prettier": "3.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "4.3.1",
    "simple-icons": "16.31.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zustand": "4.4.7"
  }
}
